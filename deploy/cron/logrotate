# Rotação dos logs do cron do Bandejão (BD-07, #147). Instalar:
#   sudo install -m 644 -o root -g root deploy/cron/logrotate /etc/logrotate.d/bandejao
#
# Uma cópia por semana: com o rotate 4 e o arquivo atual, ficam cerca de 5
# semanas de log. Os logs têm o resumo de cada execução e, em falha, a
# mensagem de erro com o traceback; não levam e-mail, matrícula nem nome.
/var/log/bandejao/*.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    # A pasta é do azureuser (as tarefas rodam como ele); sem o "su", o
    # logrotate recusa rodar numa pasta que não é do root.
    su azureuser azureuser
    create 0640 azureuser azureuser
}
