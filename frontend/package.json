{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ci": "vitest run --coverage",
    "mutacao": "stryker run",
    "e2e": "playwright test",
    "e2e:subir": "docker compose -f e2e/docker-compose.yml up -d --build --wait && npm run e2e:dados",
    "e2e:relogio": "docker compose -f e2e/docker-compose.yml up -d --no-deps --force-recreate --wait backend",
    "e2e:dados": "docker compose -f e2e/docker-compose.yml exec -T backend sh -c \"python manage.py flush --noinput && python manage.py shell -c 'from django.core.cache import cache; cache.clear()' && python manage.py loaddata campi marcadores /e2e-dados/cardapio.json /e2e-dados/contas.json /e2e-dados/historico-fila.json\"",
    "e2e:descer": "docker compose -f e2e/docker-compose.yml down -v",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:ci": "oxlint . --deny-warnings && eslint . --max-warnings 0",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
