# Caddy dos testes de ponta a ponta (FE-18): o mesmo roteamento do Caddyfile
# de produção (PWA e API no mesmo endereço, ADR 0007; /api e /admin para o
# backend e o resto para o build do PWA), em HTTP na porta 80 do container,
# sem pedir certificado. Ficam de fora o que não muda os fluxos testados: os
# cabeçalhos de segurança, a compressão, o cache longo dos /assets e o
# /static/ do admin.
{
	auto_https off
}

:80 {
	@backend path /api/* /admin /admin/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle /assets/* {
		root * /srv/pwa
		file_server
	}

	handle {
		root * /srv/pwa
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
