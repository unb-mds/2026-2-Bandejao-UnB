# Copie para .env (o .env não vai para o Git) e ajuste os valores.
SECRET_KEY=troque-por-uma-chave-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# Em produção (HTTPS) os dois ficam True, que é o padrão. Em desenvolvimento,
# com o runserver em HTTP, ficam False.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Origens que podem enviar o CSRF (o PWA em desenvolvimento).
CSRF_TRUSTED_ORIGINS=http://localhost:5173
