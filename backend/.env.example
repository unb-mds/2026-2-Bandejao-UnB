# Copie para .env (o .env não vai para o Git) e ajuste os valores.
#
# ATENÇÃO: este arquivo é só para DESENVOLVIMENTO. Em produção:
#   - DEBUG=False (ou remova a linha; o padrão já é False);
#   - SECRET_KEY própria e secreta;
#   - não defina SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE: sem DEBUG, os
#     dois ficam True sozinhos (cookies só por HTTPS).
SECRET_KEY=troque-por-uma-chave-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# Origens que podem enviar o CSRF (o PWA em desenvolvimento).
CSRF_TRUSTED_ORIGINS=http://localhost:5173
