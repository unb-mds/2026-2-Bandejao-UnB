# Copie para .env (o .env não vai para o Git) e ajuste os valores.
#
# Este arquivo serve para DESENVOLVIMENTO. Em produção, o .env fica na raiz do
# repositório, na VM, e o Compose o repassa ao backend sem mudar os nomes. A
# lista de produção está no fim deste arquivo e em
# docs/deploy/deploy-producao.md.
#
# As variáveis do Django têm o prefixo DJANGO_ (BD-05). Um .env com os nomes
# antigos (SECRET_KEY, DEBUG, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS) para o
# servidor na subida, com a lista do que renomear.

# Chave do Django. Em produção, uma própria e secreta.
DJANGO_SECRET_KEY=troque-por-uma-chave-local
# Em produção: False (ou remova a linha; o padrão já é False).
DJANGO_DEBUG=True
# Domínios aceitos. Em produção (sem DEBUG) é obrigatório.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens que podem enviar o CSRF (o PWA em desenvolvimento).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Banco. Sem DB_ENGINE=mysql, o Django usa o SQLite (db.sqlite3). Em produção
# o entrypoint.sh recusa subir sem o MySQL.
DB_ENGINE=sqlite
# Só com DB_ENGINE=mysql:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ru_db
# DB_USER=ru_user
# DB_PASSWORD=

# Não defina SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE: sem DEBUG, os dois
# ficam True sozinhos (cookies só por HTTPS).
#
# Em produção, o HTTPS do Caddy é reconhecido sozinho (ATRAS_DE_PROXY_HTTPS
# acompanha o DEBUG). Só defina ATRAS_DE_PROXY_HTTPS=False se o Gunicorn
# ficar exposto direto, sem o Caddy na frente.
# A mesma variável decide de onde vem o IP do limite de taxa (#123): com
# False em produção, todo pedido conta como o IP do Caddy, e o sistema inteiro
# divide um limite só.

# E-mail (ADR 0012). Os nomes abaixo viram o MAILERS do settings.py
# (Django 6.1). Em desenvolvimento, com DEBUG=True, o e-mail aparece no
# terminal do runserver e nada abaixo é necessário.
#
# Em produção (Brevo), só o backend SMTP é aceito (não defina EMAIL_BACKEND),
# e EMAIL_HOST, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD e DEFAULT_FROM_EMAIL são
# obrigatórios: sem eles o servidor não sobe. O EMAIL_HOST é o relay SMTP do
# Brevo (smtp-relay.brevo.com; confira no painel). A senha é a chave SMTP do
# Brevo e nunca vai para o Git. O remetente precisa estar verificado no Brevo.
# A porta (587) e o TLS (True) já são o padrão.
#
# Para testar o SMTP de verdade em desenvolvimento, descomente e preencha:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Só se precisar mudar o padrão:
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=nao-responda@bandejaounb.com.br

# Destinatário dos alertas do Leitor de Cardápio (ADR 0006 e 0012, BE-12).
# Opcional, inclusive em produção: sem a variável, o padrão é o endereço da
# equipe abaixo.
# EMAIL_EQUIPE=equipe@bandejaounb.com.br

# Endereço do PWA, usado no link de confirmação de e-mail
# (<URL_DO_PWA>/confirmar-email?token=...). Em produção é obrigatório: use o
# domínio do site, com https.
URL_DO_PWA=http://localhost:5173

# ---------------------------------------------------------------------------
# Produção (BD-05): o .env da VM, na raiz do repositório. Os segredos ficam
# só lá, nunca no Git.
#
# DJANGO_SECRET_KEY=<segredo>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=bandejaounb.com.br,www.bandejaounb.com.br
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bandejaounb.com.br,https://www.bandejaounb.com.br
# URL_DO_PWA=https://bandejaounb.com.br
# DB_ENGINE=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=bandejao
# DB_USER=<usuário da aplicação>
# DB_PASSWORD=<segredo>
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=<login SMTP do Brevo>
# EMAIL_HOST_PASSWORD=<segredo>
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=<remetente verificado no Brevo>
# SECURE_HSTS_SECONDS: sem DEBUG, o padrão é 3600 (1 hora). Depois que o
# HTTPS estiver estável, use 31536000 (1 ano). Sem a linha, vale o padrão.
# SECURE_HSTS_SECONDS=3600
# EMAIL_EQUIPE é opcional; o padrão já é o endereço abaixo.
# EMAIL_EQUIPE=equipe@bandejaounb.com.br
#
# O MYSQL_ROOT_PASSWORD e o usuário da equipe (DB_EQUIPE_USER e
# DB_EQUIPE_PASSWORD) NÃO entram aqui: ficam no .env.db, que só o container do
# banco lê.
