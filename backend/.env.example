# Copie para .env (o .env não vai para o Git) e ajuste os valores.
#
# ATENÇÃO: este arquivo é só para DESENVOLVIMENTO. Em produção:
#   - DEBUG=False (ou remova a linha; o padrão já é False);
#   - SECRET_KEY própria e secreta;
#   - não defina SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE: sem DEBUG, os
#     dois ficam True sozinhos (cookies só por HTTPS).
SECRET_KEY=troque-por-uma-chave-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# Em produção, o HTTPS do Caddy é reconhecido sozinho (ATRAS_DE_PROXY_HTTPS
# acompanha o DEBUG). Só defina ATRAS_DE_PROXY_HTTPS=False se o Gunicorn
# ficar exposto direto, sem o Caddy na frente.
# A mesma variável decide de onde vem o IP do limite de taxa (#123): com
# False em produção, todo pedido conta como o IP do Caddy, e o sistema inteiro
# divide um limite só.

# Origens que podem enviar o CSRF (o PWA em desenvolvimento).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# E-mail (ADR 0012). Os nomes abaixo viram o MAILERS do settings.py
# (Django 6.1). Em desenvolvimento, com DEBUG=True, o e-mail aparece no
# terminal do runserver e nada abaixo é necessário.
#
# Em produção (Brevo), o backend padrão já é o SMTP, e EMAIL_HOST,
# EMAIL_HOST_USER e EMAIL_HOST_PASSWORD são obrigatórios: sem eles o servidor
# não sobe. O EMAIL_HOST é o relay SMTP do Brevo (confira no painel). A senha
# é a chave SMTP do Brevo e nunca vai para o Git. A porta (587), o TLS (True)
# e o remetente (nao-responda@bandejaounb.com.br) já são o padrão.
#
# Para testar o SMTP de verdade em desenvolvimento, descomente e preencha:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Só se precisar mudar o padrão:
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=nao-responda@bandejaounb.com.br

# Endereço do PWA, usado no link de confirmação de e-mail
# (<URL_DO_PWA>/confirmar-email?token=...). Em produção é obrigatório: use o
# domínio do site, com https.
URL_DO_PWA=http://localhost:5173
